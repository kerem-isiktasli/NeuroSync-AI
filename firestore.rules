rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    /** Global nickname registry — server (Admin SDK) only; clients use /api/profile/nickname */
    match /nicknames/{nick} {
      allow read, write: if false;
    }

    match /analysisIntakes/{intakeId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /roles/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;
      allow write: if false;
    }

    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin';
    }

    match /config_history/{docId} {
      allow read, write: if request.auth != null
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin';
    }

    match /credits/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;
      allow write: if false;
    }

    match /supportRoles/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;
      allow write: if false;
    }

    function isSupport() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/supportRoles/$(request.auth.uid))
          && get(/databases/$(database)/documents/supportRoles/$(request.auth.uid)).data.role == 'support')
        ||
        (exists(/databases/$(database)/documents/roles/$(request.auth.uid))
          && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin')
      );
    }

    match /supportTickets/{ticketId} {
      allow create: if request.auth != null
        && request.resource.data.patientUid == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.patientUid == request.auth.uid || isSupport());
      allow update: if request.auth != null
        && (
          (resource.data.patientUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['patientUnread', 'updatedAt']))
          || isSupport()
        );
      allow delete: if false;
    }

    match /supportTickets/{ticketId}/messages/{msgId} {
      allow read: if request.auth != null
        && (
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.patientUid == request.auth.uid
          || isSupport()
        );
      allow create: if request.auth != null
        && request.resource.data.senderUid == request.auth.uid
        && (
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.patientUid == request.auth.uid
          || isSupport()
        );
      allow update, delete: if false;
    }

    match /supportPresence/{userId} {
      allow read: if request.auth != null && isSupport();
      allow write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /notifications/{userId}/items/{notifId} {
      allow read, update: if request.auth != null
        && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
